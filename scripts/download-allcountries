#!/bin/bash
#
# Download allCountries.txt from GeoNames
# Complete worldwide dataset
#
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DOWNLOAD_URL="http://download.geonames.org/export/dump/allCountries.zip"
ZIP_FILE="$PROJECT_ROOT/data/allCountries.zip"
TXT_FILE="$PROJECT_ROOT/data/allCountries.txt"

echo "=========================================="
echo "Download AllCountries Dataset"
echo "=========================================="
echo ""
echo "Source: GeoNames (http://www.geonames.org/)"
echo "License: CC BY 4.0"
echo "Download size: ~1.5 GB"
echo "Extracted size: ~3 GB"
echo ""

if [ -f "$TXT_FILE" ]; then
    echo "allCountries.txt already exists"
    FILE_SIZE=$(du -h "$TXT_FILE" | cut -f1)
    LINE_COUNT=$(wc -l < "$TXT_FILE")
    echo "Size: $FILE_SIZE, Records: $LINE_COUNT"
    echo ""
    read -p "Re-download? (y/n) " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 0
    fi
    rm -f "$TXT_FILE" "$ZIP_FILE"
fi

read -p "Continue with download? (y/n) " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 1
fi

echo ""
echo "Downloading... (this may take several minutes)"
if command -v wget &> /dev/null; then
    wget --progress=bar:force -O "$ZIP_FILE" "$DOWNLOAD_URL"
elif command -v curl &> /dev/null; then
    curl -L --progress-bar -o "$ZIP_FILE" "$DOWNLOAD_URL"
else
    echo "Error: Neither wget nor curl is available"
    exit 1
fi

echo ""
echo "Extracting..."
unzip -q "$ZIP_FILE" -d "$PROJECT_ROOT/data"

read -p "Delete zip file to save space? (y/n) " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    rm -f "$ZIP_FILE"
fi

echo ""
echo "Done: $TXT_FILE"
du -h "$TXT_FILE"

# Extract ADM1 local names for use by all imports (including cities15000)
ADM1_LOCAL="$PROJECT_ROOT/data/admin1-local-names.tsv"
ALTNAMES_FILE="$PROJECT_ROOT/data/alternateNamesV2.txt"
echo ""
echo "Extracting ADM1 local names..."
# Step 1: extract ADM1 entries (geonameid, key, name, country)
ADM1_RAW="/tmp/adm1_raw.tsv"
awk -F'\t' '$7=="A" && $8=="ADM1" { print $1 "\t" $9 "." $11 "\t" $2 "\t" $9 }' "$TXT_FILE" > "$ADM1_RAW"
echo "ADM1 entries: $(wc -l < "$ADM1_RAW")"

if [ -f "$ALTNAMES_FILE" ]; then
    # Step 2: find preferred native-language names from alternateNamesV2.txt
    # Country→language: DE→de, AT→de, CH→de, NL→nl, BE→nl, etc.
    # For each ADM1 geonameid, find the preferred alternate name in the country's language
    echo "Resolving native-language names from alternateNamesV2.txt..."
    awk -F'\t' '
    BEGIN {
        # Map country codes to their primary language
        split("AD:ca,AT:de,BE:nl,CH:de,DE:de,DK:da,ES:es,FI:fi,FR:fr,GB:en,GR:el,IE:en,IT:it,LI:de,LU:lb,NL:nl,NO:no,PT:pt,SE:sv", pairs, ",")
        for (i in pairs) {
            split(pairs[i], kv, ":")
            lang[kv[1]] = kv[2]
        }
    }
    NR==FNR {
        gid[$1] = $2      # geonameid → key (CC.admin1)
        name[$1] = $3      # geonameid → default name
        cc[$1] = $4        # geonameid → country code
        next
    }
    ($2 in gid) && $3 != "" {
        country = cc[$2]
        if (country in lang && $3 == lang[country]) {
            pref = ($6+0 == 1) ? 2 : ($5+0 == 1) ? 1 : 0
            if (!($2 in best) || pref > rank[$2]) {
                best[$2] = $4
                rank[$2] = pref
            }
        }
    }
    END {
        for (id in gid) {
            if (id in best) print gid[id] "\t" best[id]
            else print gid[id] "\t" name[id]
        }
    }' "$ADM1_RAW" "$ALTNAMES_FILE" > "$ADM1_LOCAL"
else
    # No alternateNames available, use allCountries names as-is
    awk -F'\t' '{ print $2 "\t" $3 }' "$ADM1_RAW" > "$ADM1_LOCAL"
fi
rm -f "$ADM1_RAW"
echo "Done: $ADM1_LOCAL ($(wc -l < "$ADM1_LOCAL") entries)"

echo ""
echo "Next: ./scripts/import-allcountries"
