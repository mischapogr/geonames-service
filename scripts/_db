#!/bin/bash
#
# Shared database environment for import scripts.
# Source this file: source "$(dirname "${BASH_SOURCE[0]}")/_db"
#
# Detects Docker (local dev) vs direct mysql (shared hosting).
# Provides: run_mysql, load_data_file

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Used by the scripts that source this file
# shellcheck disable=SC2034
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Detect environment
if docker compose ps --quiet database 2>/dev/null | grep -q .; then
    DB_MODE="docker"
    echo "Environment: Docker (local dev)"
else
    DB_MODE="direct"

    # Load credentials from scripts/.env (created by deploy on remote)
    if [[ -f "$SCRIPT_DIR/.env" ]]; then
        set -a
        source "$SCRIPT_DIR/.env"
        set +a
    fi

    DB_HOST="${DB_HOST:-localhost}"
    DB_PORT="${DB_PORT:-3306}"
    DB_NAME="${DB_NAME:-geonames}"
    DB_USER="${DB_USER:-geonames}"
    DB_PASS="${DB_PASS:-}"

    echo "Environment: Direct mysql ($DB_USER@$DB_HOST:$DB_PORT/$DB_NAME)"
fi

# Run a mysql command/query
# Usage: run_mysql -e "SELECT 1"
#        echo "SELECT 1" | run_mysql
run_mysql() {
    if [[ "$DB_MODE" == "docker" ]]; then
        docker compose exec -T database mysql -ugeonames -pgeonames geonames "$@"
    else
        mysql -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" "$@"
    fi
}

# Load a TSV file into a table using LOAD DATA
# Usage: load_data_file <local_file> <table_name> <columns>
# Example: load_data_file /tmp/data.tsv cityinfo "(geonameid, name, latitude)"
load_data_file() {
    local local_file="$1"
    local table="$2"
    local columns="$3"

    if [[ "$DB_MODE" == "docker" ]]; then
        local container
        container=$(docker compose ps -q database)
        local remote_path
        remote_path="/var/lib/mysql-files/$(basename "$local_file")"
        docker cp "$local_file" "$container:$remote_path"
        run_mysql -e "LOAD DATA INFILE '$remote_path'
            INTO TABLE $table
            FIELDS TERMINATED BY '\t'
            LINES TERMINATED BY '\n'
            $columns"
        docker compose exec -T database rm -f "$remote_path"
    else
        mysql -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" \
            --local-infile=1 \
            -e "LOAD DATA LOCAL INFILE '$local_file'
                INTO TABLE $table
                FIELDS TERMINATED BY '\t'
                LINES TERMINATED BY '\n'
                $columns"
    fi
}

# Abort unless a column exists, so an import never truncates a table it cannot reload
# Usage: require_column <table> <column> <migration_file>
# Example: require_column cityinfo feature_code 005-add-feature-code.sql
require_column() {
    local table="$1"
    local column="$2"
    local migration="$3"
    local found

    # </dev/null: docker compose exec would otherwise consume the caller's stdin (the y/n prompt)
    found=$(run_mysql -sN -e "SELECT COUNT(*) FROM information_schema.COLUMNS
        WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = '$table' AND COLUMN_NAME = '$column'" </dev/null)
    if [[ "$found" != "1" ]]; then
        echo "Error: column $table.$column is missing"
        echo "Apply migrations/$migration first, then re-run this script"
        exit 1
    fi
}
