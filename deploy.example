#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=false
RUN_MIGRATIONS=false
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --migrate) RUN_MIGRATIONS=true ;;
    esac
done

run_remote() {
    if $DRY_RUN; then
        echo "[dry-run] ssh ${DEPLOY_HOST} \"$*\""
        cat > /dev/null  # consume any heredoc stdin
    else
        ssh "${DEPLOY_HOST}" "$@"
    fi
}

# Load .env.deploy if it exists
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/.env.deploy" ]]; then
    echo "Loading .env.deploy..."
    set -a
    source "${SCRIPT_DIR}/.env.deploy"
    set +a
fi

# ── Configuration ────────────────────────────────────────────────────
DEPLOY_HOST="${DEPLOY_HOST:?Set DEPLOY_HOST (e.g. user@host.example.com)}"
SUBDOMAIN="${SUBDOMAIN:?Set SUBDOMAIN (e.g. geonames.yourdomain.com)}"
SUBDOMAIN_URL="${SUBDOMAIN_URL:-${SUBDOMAIN}}"

# Safety: abort if SUBDOMAIN is empty or contains path traversal
if [[ -z "${SUBDOMAIN}" || "${SUBDOMAIN}" == *".."* || "${SUBDOMAIN}" == /* || ! "${SUBDOMAIN}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]+$ ]]; then
    echo "ERROR: Invalid SUBDOMAIN '${SUBDOMAIN}'. Must be alphanumeric (dots, hyphens allowed). Aborting to protect remote filesystem."
    exit 1
fi

# The tilde is expanded by the remote shell (rsync/ssh target), not locally.
# shellcheck disable=SC2088
REMOTE_ROOT="~/public_html/${SUBDOMAIN}"

# Database credentials on remote host (set via env or .env.deploy)
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-3306}"
DB_NAME="${DB_NAME:-geonames}"
DB_USER="${DB_USER:-geonames}"
DB_PASS="${DB_PASS:-}"
CORS_ORIGIN="${CORS_ORIGIN:-*}"
API_KEY="${API_KEY:-}"
CACHE_TTL="${CACHE_TTL:-3600}"           # APCu cache TTL in seconds (0 = disabled)
HTTP_CACHE_TTL="${HTTP_CACHE_TTL:-300}"  # Cache-Control max-age in seconds (0 = disabled)

# ── Deploy files via rsync ───────────────────────────────────────────
$DRY_RUN && echo "=== DRY RUN — no changes will be made ==="
echo "Deploying to ${DEPLOY_HOST}:${REMOTE_ROOT}..."

# Verify remote directory exists (created by subdomain setup)
if ! $DRY_RUN; then
    ssh "${DEPLOY_HOST}" "test -d ${REMOTE_ROOT}" || {
        echo "ERROR: Remote directory ${REMOTE_ROOT} does not exist."
        echo "Create the subdomain first, then re-run this script."
        exit 1
    }
fi

# rsync ONLY project files to the subdomain directory (never the home dir)
RSYNC_OPTS="-avz --itemize-changes --delete-after --max-delete=0"
$DRY_RUN && RSYNC_OPTS="${RSYNC_OPTS} --dry-run"

rc=0
rsync ${RSYNC_OPTS} \
    --exclude='.git' \
    --exclude='.github' \
    --exclude='docker-compose.yml' \
    --exclude='Dockerfile' \
    --exclude='docker/' \
    --exclude='data/' \
    --exclude='.env.deploy' \
    --exclude='deploy' \
    --exclude='deploy.example' \
    --exclude='.releaserc.json' \
    --exclude='CLAUDE.md' \
    --exclude='AI.md' \
    --exclude='README.md' \
    --exclude='LICENSE' \
    --exclude='src/.env.php' \
    --exclude='scripts/.env' \
    --exclude='_tmp/' \
    --exclude='.claude/' \
    --exclude='.idea/' \
    --exclude='.vscode/' \
    --exclude='tests/' \
    --exclude='phpunit.xml' \
    --exclude='.phpunit.result.cache' \
    --exclude='composer.json' \
    --exclude='composer.lock' \
    --exclude='vendor/' \
    --exclude='playwright.config.ts' \
    --exclude='playwright-report/' \
    --exclude='test-results/' \
    --exclude='node_modules/' \
    --exclude='package.json' \
    --exclude='package-lock.json' \
    --exclude='docs/' \
    --exclude='scripts/loadtest' \
    --exclude='.gitignore' \
    --filter='P cgi-bin/' \
    --filter='P .htaccess' \
    "${SCRIPT_DIR}/" "${DEPLOY_HOST}:${REMOTE_ROOT}/" || rc=$?
if [[ $rc -ne 0 && $rc -ne 25 ]]; then
    echo "ERROR: rsync failed with exit code $rc"
    exit $rc
fi

echo "Files synced."

# ── Append rewrite rules to .htaccess (preserving existing content) ──
echo "Updating .htaccess..."
run_remote "grep -q 'RewriteRule.*src/index.php' ${REMOTE_ROOT}/.htaccess 2>/dev/null || cat >> ${REMOTE_ROOT}/.htaccess" <<'HTACCESS'

# Geonames API routing
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ src/index.php [QSA,L]
HTACCESS

# ── Create environment config on remote host ────────────────────────────────
echo "Writing remote .env.php config..."
run_remote "cat > ${REMOTE_ROOT}/src/.env.php" <<EOF
<?php
// Auto-generated by deploy — do not edit manually
putenv('DB_HOST=${DB_HOST}');
putenv('DB_PORT=${DB_PORT}');
putenv('DB_NAME=${DB_NAME}');
putenv('DB_USER=${DB_USER}');
putenv('DB_PASS=${DB_PASS}');
putenv('CORS_ORIGIN=${CORS_ORIGIN}');
putenv('API_KEY=${API_KEY}');
putenv('CACHE_TTL=${CACHE_TTL}');
putenv('HTTP_CACHE_TTL=${HTTP_CACHE_TTL}');
EOF

# ── Create scripts/.env for import scripts on remote host ──────────
echo "Writing remote scripts/.env..."
run_remote "cat > ${REMOTE_ROOT}/scripts/.env" <<EOF
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASS=${DB_PASS}
EOF

# ── Run migrations (opt-in with --migrate) ─────────────────────────
if $RUN_MIGRATIONS; then
    echo "Running migrations..."
    run_remote "cd ${REMOTE_ROOT} && \
        for f in migrations/*.sql; do \
            echo \"Applying \$f...\"; \
            mysql -h ${DB_HOST} -P ${DB_PORT} -u ${DB_USER} -p'${DB_PASS}' ${DB_NAME} < \"\$f\" 2>&1 || true; \
        done"
else
    echo "Skipping migrations (use --migrate to run)"
fi

echo ""
echo "Deployment complete!"
echo "API should be available at: https://${SUBDOMAIN_URL}/api/cities/search?q=test"
